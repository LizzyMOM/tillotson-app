# Database (Supabase gives you this under Project settings → Database → Connection string)
DATABASE_URL=postgres://postgres@localhost:5432/eventapp

# Web address of the app, used in payment return links and emails
APP_URL=http://localhost:3000

# Card payments. Leave empty to use test payments (never in production).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Emails. Leave empty to write emails to the .mail folder instead of sending them.
RESEND_API_KEY=
MAIL_FROM="T4 Nations Cup <registration@example.com>"

# Where licence uploads are kept. 'local' stores them in .uploads (development only).
STORAGE=local

# ---- Order Angel (dealer orders) ----
# The Tillotson website. Read/write key from WooCommerce → Settings → Advanced → REST API.
# Leave empty to run Order Angel on its own (local testing): changes stay in the app.
WOO_URL=
WOO_KEY=
WOO_SECRET=
# The secret typed into both WooCommerce webhooks (Order created, Order updated) → APP_URL/api/woo/webhook
WOO_WEBHOOK_SECRET=
# Signs the sign-in cookie. Any long random string; required in production.
ORDER_ANGEL_SESSION_SECRET=
# Lets the daily check (/api/orders/daily) and the first import (/api/orders/import) run.
CRON_SECRET=
# Local testing: the pick-an-account sign-in page. Never set this in production (Tillotson ID replaces it).
ORDER_ANGEL_DEV_SIGNIN=
