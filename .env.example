# Database (Supabase gives you this under Project settings → Database → Connection string)
DATABASE_URL=postgres://postgres@localhost:5432/eventapp

# Web address of the app, used in payment return links and emails
APP_URL=http://localhost:3000

# Card payments. Leave empty to use test payments (never in production).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Emails. Leave empty to write emails to the .mail folder instead of sending them.
RESEND_API_KEY=
MAIL_FROM="T4 Nations Cup <registration@example.com>"

# Where licence uploads are kept. 'local' stores them in .uploads (development only).
STORAGE=local
